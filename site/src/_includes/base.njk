<!doctype html>
<html lang="en" data-theme="dark">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<script>try { var t = localStorage.getItem("tur-theme"); if (t) document.documentElement.dataset.theme = t; } catch (e) {}</script>
<title>{{ title | escape }}</title>
<meta name="description" content="{{ description | escape }}">
<meta name="theme-color" content="#0F2238">
<link rel="canonical" href="{{ site.url }}{{ page.url }}">
<link rel="icon" type="image/svg+xml" href="/assets/favicon.svg">
<meta property="og:title" content="{{ title | escape }}">
<meta property="og:description" content="{{ description | escape }}">
<meta property="og:image" content="{{ site.url }}/assets/social-preview.png">
<meta property="og:url" content="{{ site.url }}{{ page.url }}">
<meta property="og:type" content="website">
<meta property="og:site_name" content="Tur">
<meta name="twitter:card" content="summary_large_image">
<link rel="stylesheet" href="/assets/site.css">
</head>
<body data-base="{{ '/' | htmlBaseUrl }}">
<a class="skip" href="#main">Skip to content</a>
<header class="topbar">
  <a class="topbar__brand" href="/"><img src="/assets/favicon.svg" alt="" width="28" height="28">Tur</a>
  <nav class="topbar__links" aria-label="Main">
    <a href="/docs/guide/quickstart/">Get started</a>
    <a href="/docs/">Docs</a>
    <a href="/benchmarks/">Benchmarks</a>
    <a href="/docs/architecture/comparison/">Compare</a>
  </nav>
  <div class="topbar__tools">
    <button class="search-open" type="button" data-search-open aria-label="Search the docs"><span>Search</span><kbd>/</kbd></button>
    <button class="icon-btn" type="button" data-theme-toggle aria-label="Switch between dark and light">
      <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><circle cx="12" cy="12" r="9" fill="none" stroke="currentColor" stroke-width="2"/><path d="M12 3a9 9 0 0 1 0 18z" fill="currentColor"/></svg>
    </button>
    <a class="icon-btn" href="{{ site.repo }}" aria-label="Tur on GitHub">
      <svg viewBox="0 0 16 16" width="18" height="18" aria-hidden="true" fill="currentColor"><path d="M8 0a8 8 0 0 0-2.53 15.59c.4.07.55-.17.55-.38v-1.34c-2.23.48-2.7-1.07-2.7-1.07-.36-.92-.89-1.17-.89-1.17-.73-.5.05-.49.05-.49.8.06 1.23.83 1.23.83.72 1.22 1.87.87 2.33.66.07-.52.28-.87.5-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82a7.6 7.6 0 0 1 4 0c1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48v2.2c0 .21.15.46.55.38A8 8 0 0 0 8 0z"/></svg>
    </a>
  </div>
</header>

{{ content | safe }}

<div class="rushnyk" aria-hidden="true"></div>
<footer class="footer">
  <span>Tur: local inference with a little muscle. Built for Apple Silicon, written in Rust.</span>
  <span><a href="{{ site.repo }}/blob/main/LICENSE">Apache-2.0</a> · <a href="{{ site.repo }}">GitHub</a> · <a href="{{ site.repo }}/releases/latest">Releases</a></span>
</footer>

<dialog class="search" data-search>
  <form method="dialog" class="search__bar">
    <input type="search" placeholder="Search the docs" aria-label="Search the docs" data-search-input autocomplete="off">
    <button class="search__close" aria-label="Close search">Esc</button>
  </form>
  <ol class="search__results" data-search-results></ol>
</dialog>
<div class="tip" data-tip-box role="status" hidden></div>
<script src="/assets/site.js" defer></script>
{% if labs %}<script type="application/json" id="lab-data">{{ perf.lab | dump | safe }}</script>
<script src="/assets/lab.js" defer></script>{% endif %}
</body>
</html>
