  <section class="wrap band">
    <h2>Up and running</h2>
    <p class="band__lead">You need an Apple Silicon Mac. The first run downloads the model into your Hugging Face cache, and the pinned revision means every run loads the same weights.</p>
    <div class="tabs" data-tabs>
      <div class="tabs__list" role="tablist" aria-label="Commands">
        <button role="tab" aria-selected="true" data-tab="run">Generate</button>
        <button role="tab" aria-selected="false" data-tab="serve">Serve</button>
        <button role="tab" aria-selected="false" data-tab="connect">Connect</button>
