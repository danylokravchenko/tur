<main id="main">
  <section class="stats wrap" aria-label="Headline measurements">
    <a class="stat" href="/benchmarks/#batching"><b>+{{ perf.stats.batched }}%</b><span>eight-sequence decode against llama.cpp, {{ perf.stats.batchedTok }} tok/s to {{ perf.stats.batchedBase }} on an M3 Pro</span></a>
