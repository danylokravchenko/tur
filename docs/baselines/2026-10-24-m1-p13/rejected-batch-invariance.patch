+#[test]
+fn test_invariant_execution_is_bit_identical_across_batches_orders_and_chunks() -> Result<()> {
+    let _gpu = GPU.lock();
+    let checkpoint = small()?;
+    let device = metal()?;
+    for format in [WeightFormat::Q8_0, WeightFormat::Q4K] {
+        let kv = KvLayout::new(16, KvFormat::Q8);
+        let model = load_kv(&checkpoint.0, format, &device, Execution::Invariant, kv)?;
+        assert_eq!(model.execution(), Execution::Invariant);
+        assert_eq!(batch_invariance_violations(&model)?, 0, "{format:?}");
+        // F32 dequantization and accumulation throughout: a prefill tracks the reference fed
+        // one token at a time (Candle's one-row F32 GEMV), unlike the default kernels'
+        // F16-staged tiles for long passes.
+        let tokens = prompt(100, 39);
+        let invariant = prefill(&model, ModelState::new(&pool(&model)?), &tokens, 100)?.0;
+        let reference = model.with_execution(Execution::Reference)?;
+        let exact = prefill(&reference, ModelState::new(&pool(&reference)?), &tokens, 1)?.0;
+        let fused = reference.with_execution(Execution::Fused)?;
+        let default = prefill(&fused, ModelState::new(&pool(&fused)?), &tokens, 100)?.0;
+        let (error, default_error) = (
+            max_relative(&invariant, &exact),
+            max_relative(&default, &exact),
+        );
+        eprintln!(
+            "{format:?}: prefill vs one-token reference: invariant {error:.1e}, default \
+             {default_error:.1e}"
+        );
+        assert!(error < 1e-4, "{format:?}: {error}");
+        // Default kernels adapt to the batch; report how often that shows in the bits.
+        let violations = batch_invariance_violations(&fused)?;
+        eprintln!("{format:?}: {violations} of 15 comparisons differ with default kernels");
+    }
+    Ok(())
+}
+
