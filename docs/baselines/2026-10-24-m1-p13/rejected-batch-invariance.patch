diff --git a/crates/tur/tests/batch_invariance.rs b/crates/tur/tests/batch_invariance.rs
new file mode 100644
index 0000000..fa993c7
--- /dev/null
+++ b/crates/tur/tests/batch_invariance.rs
@@ -0,0 +1,134 @@
+#![cfg(feature = "metal")]
+#![forbid(unsafe_code)]
+#![allow(
+    clippy::panic_in_result_fn,
+    clippy::print_stderr,
+    reason = "tests assert outcomes after fallible setup and report default-kernel drift"
+)]
+//! Batch-invariant execution through the serving pipeline: a sampled request's tokens are
+//! the same alone, batched with other traffic in another chunking, recomputed after
+//! preemption, restored from prefix snapshots and verified speculatively.
+mod common;
+
+use candle_core::Device;
+use std::collections::HashMap;
+use tur::{
+    InferencePipeline, ModelFactory, Result, TurError,
+    backend::{
+        pipeline::{GenerationRequest, PipelineConfig},
+        prefix::PrefixConfig,
+        speculation::SpeculationConfig,
+    },
+    models::qwen3_5::{Execution, WeightFormat},
+};
+
+fn requests() -> Vec<GenerationRequest> {
+    (0..6usize)
+        .map(|i| {
+            // Repeated phrases give prompt lookup something to draft from.
+            let prompt = (0..20 + i * 9)
+                .map(|t| format!("t{}", 2 + (t % (5 + i) * 7 + i) % 90))
+                .collect::<Vec<_>>()
+                .join(" ");
+            let mut request = GenerationRequest::new(prompt, 40);
+            request.seed = 7 + i as u64;
+            request.sampling.temperature = Some(0.9);
+            request.sampling.top_p = Some(0.95);
+            request
+        })
+        .collect()
+}
+
+/// Run every request through one pipeline at once; returns texts in request order, total
+/// preemptions and accepted-or-not draft tokens.
+fn serve(
+    factory: &ModelFactory,
+    config: PipelineConfig,
+    requests: &[GenerationRequest],
+) -> Result<(Vec<String>, usize, usize)> {
+    let mut pipeline = InferencePipeline::new(factory, config)?;
+    let ids = requests
+        .iter()
+        .enumerate()
+        .map(|(i, request)| Ok((pipeline.submit_request(request)?, i)))
+        .collect::<Result<HashMap<_, _>>>()?;
+    let mut texts = vec![String::new(); requests.len()];
+    let (mut preemptions, mut drafts) = (0, 0);
+    for _ in 0..10_000 {
+        if pipeline.active_request_count() == 0 {
+            return Ok((texts, preemptions, drafts));
+        }
+        for (id, result) in pipeline.step_streaming()?.completed {
+            let stats = result?;
+            let index = ids
+                .get(&id)
+                .ok_or_else(|| TurError::Other("unknown completion".into()))?;
+            texts[*index] = stats.generated_text;
+            preemptions += stats.preemptions;
+            drafts += stats.draft_tokens;
+        }
+    }
+    Err(TurError::Other("requests did not finish".into()))
+}
+
+/// Requests whose text differs from serving each alone, under concurrent batching,
+/// preemption and speculation; asserts that each schedule exercised its mechanism.
+fn schedule_violations(factory: &ModelFactory) -> Result<usize> {
+    let requests = requests();
+    let alone = PipelineConfig {
+        prefix: PrefixConfig::DISABLED,
+        ..PipelineConfig::new(1, 8)
+    };
+    let expected = requests
+        .iter()
+        .map(|request| Ok(serve(factory, alone, std::slice::from_ref(request))?.0))
+        .collect::<Result<Vec<_>>>()?
+        .concat();
+    // Six at once in another chunk size, with prefix snapshots every 32 tokens.
+    let mut batched = PipelineConfig::new(6, 13);
+    batched.prefix.spacing = 32;
+    // A pool too small for every request at once forces recompute preemption.
+    let probe = InferencePipeline::new(factory, batched)?.memory()?;
+    let mut pressured = PipelineConfig {
+        prefix: PrefixConfig::DISABLED,
+        ..PipelineConfig::new(6, 11)
+    };
+    pressured.state_bytes = Some(8 * probe.slot_bytes + 9 * probe.page_bytes);
+    let speculative = PipelineConfig {
+        prefix: PrefixConfig::DISABLED,
+        speculation: SpeculationConfig::new(4),
+        ..PipelineConfig::new(4, 16)
+    };
+    let mut violations = 0;
+    for (name, config) in [
+        ("batched", batched),
+        ("pressured", pressured),
+        ("speculative", speculative),
+    ] {
+        let (texts, preemptions, drafts) = serve(factory, config, &requests)?;
+        match name {
+            "pressured" => assert!(preemptions > 0, "no preemption"),
+            "speculative" => assert!(drafts > 0, "no drafts"),
+            _ => {}
+        }
+        violations += texts.iter().zip(&expected).filter(|(a, b)| a != b).count();
+    }
+    Ok(violations)
+}
+
+#[test]
+fn test_batch_invariant_tokens_ignore_batching_preemption_prefixes_and_speculation() -> Result<()>
+{
+    let checkpoint = common::Checkpoint::fused()?;
+    let mut factory = checkpoint.factory();
+    factory.device = Device::new_metal(0)?;
+    for format in [WeightFormat::Q8_0, WeightFormat::Q4K] {
+        factory.format = Some(format);
+        factory.execution = Execution::Invariant;
+        assert_eq!(schedule_violations(&factory)?, 0, "{format:?}");
+        factory.execution = Execution::Fused;
+        let violations = schedule_violations(&factory)?;
+        eprintln!("{format:?}: {violations} of 18 request texts differ with default kernels");
+    }
+    Ok(())
+}
