+/// Bit equality, so that `-0.0`, `0.0` and NaN payloads also count as differences.
+fn identical(a: &[Vec<f32>], b: &[Vec<f32>]) -> bool {
+    a.len() == b.len()
+        && a.iter().zip(b).all(|(x, y)| {
+            x.len() == y.len() && x.iter().zip(y).all(|(p, q)| p.to_bits() == q.to_bits())
+        })
+}
+
+fn identical_state(a: &ModelState, b: &ModelState) -> Result<bool> {
+    let (a, b) = (snapshot(a)?, snapshot(b)?);
+    Ok(a.len() == b.len() && a.iter().zip(&b).all(|(x, y)| identical(x, y)))
+}
+
+/// Logits of every new token of one pass, and each sequence's committed state.
+type Pass = Vec<(Vec<Vec<f32>>, ModelState)>;
+
+fn run_pass(model: &Qwen35, batch: &[(&ModelState, &[u32])]) -> Result<Pass> {
+    let sequences: Vec<_> = batch
+        .iter()
+        .map(|&(state, tokens)| (state, tokens, Boundaries::Final))
+        .collect();
+    let (steps, reservations) = forward(model, &sequences)?;
+    let mut out = Vec::with_capacity(steps.len());
+    for ((step, reservation), (_, tokens)) in steps.into_iter().zip(&reservations).zip(batch) {
+        out.push((rows(&step?.logits)?, reservation.commit(tokens.len())?));
+    }
+    drop(reservations);
+    model.device().synchronize()?;
+    Ok(out)
+}
+
+/// Prefill `tokens` in pieces of the given lengths; returns every position's logits.
+fn prefill_pieces(
+    model: &Qwen35,
+    pool: &StatePool,
+    tokens: &[u32],
+    pieces: &[usize],
+) -> Result<(Vec<Vec<f32>>, ModelState)> {
+    let (mut state, mut logits, mut start) = (ModelState::new(pool), Vec::new(), 0);
+    for &len in pieces {
+        let piece = &tokens[start..start + len];
+        let (rows, next) = run_pass(model, &[(&state, piece)])?
+            .pop()
+            .ok_or_else(|| invalid("missing step"))?;
+        logits.extend(rows);
+        state = next;
+        start += len;
+        pool.reclaim();
+    }
+    Ok((logits, state))
+}
+
+/// Decodes beside contexts that need 1–3 attention splits, an empty sequence's prefill
+/// chunk, and the same prompt in four chunkings (including single-token chunks, which
+/// otherwise take the recurrent step kernel). Returns how many comparisons were not
+/// bit-identical.
+fn batch_invariance_violations(model: &Qwen35) -> Result<usize> {
+    // Contexts, their solo results and one batch's results are alive together.
+    let pool = common::pool(model, 512, 32)?;
+    let mut violations = 0;
+    let mut contexts = Vec::new();
+    for (len, salt) in [(37, 30), (600, 31), (1100, 32)] {
+        contexts.push(prefill(model, ModelState::new(&pool), &prompt(len, salt), 256)?.1);
+    }
+    contexts.push(ModelState::new(&pool));
+    let new = [prompt(1, 33), prompt(1, 34), prompt(1, 35), prompt(20, 36)];
+    let alone = contexts
+        .iter()
+        .zip(&new)
+        .map(|(state, tokens)| {
+            run_pass(model, &[(state, tokens.as_slice())])?
+                .pop()
+                .ok_or_else(|| invalid("missing step"))
+        })
+        .collect::<Result<Vec<_>>>()?;
+    let orders: [&[usize]; 4] = [&[0, 1, 2, 3], &[3, 2, 1, 0], &[2, 0], &[1, 3]];
+    for order in orders {
+        let batch: Vec<_> = order
+            .iter()
+            .map(|&i| (&contexts[i], new[i].as_slice()))
+            .collect();
+        for (&i, (logits, state)) in order.iter().zip(run_pass(model, &batch)?) {
+            if !identical(&logits, &alone[i].0) || !identical_state(&state, &alone[i].1)? {
+                violations += 1;
+            }
+        }
+    }
+    drop((alone, contexts));
+    pool.reclaim();
+    let tokens = prompt(700, 37);
+    let (whole, state) = prefill_pieces(model, &pool, &tokens, &[700])?;
+    for pieces in [&[1, 15, 300, 384][..], &[256, 256, 188], &[16, 1, 1, 682]] {
+        let (logits, other) = prefill_pieces(model, &pool, &tokens, pieces)?;
+        if !identical(&logits, &whole) || !identical_state(&other, &state)? {
+            violations += 1;
+        }
+    }
+    Ok(violations)
+}
