+            m[j * LD + i] = t;
+        }
+    }
+    threadgroup_barrier(mem_flags::mem_threadgroup);
+
+    // U and W: T's columns scaled by β (for V) or β e^γ (for K), lower blocks only.
+    uint vb = (dv + 7) / 8, kb = dk / 8;
+    device const float *vp = mixed + ulong(row0) * p.mixed_stride + 2 * p.key_width + h * dv;
+    for (uint blk = sg; blk < B * (vb + kb); blk += sgs) {
+        uint bi = blk / (vb + kb);
+        uint bc = blk % (vb + kb);
+        if (bi * 8 >= len) {
+            continue;
+        }
+        bool is_v = bc < vb;
+        uint col = is_v ? bc * 8 : (bc - vb) * 8;
+        uint cols = is_v ? dv - col : 8;
+        simdgroup_float8x8 acc = simdgroup_float8x8(0.0f);
+        for (uint bj = 0; bj <= bi; ++bj) {
+            if (bj * 8 >= len) {
+                break;
+            }
+            simdgroup_float8x8 t;
+            thread auto &et = t.thread_elements();
+            uint i = bi * 8 + rc.x;
+            for (uint x = 0; x < 2; ++x) {
+                uint j = bj * 8 + rc.y + x;
+                float v = i > j ? m[j * LD + i] : (i == j ? 1.0f : 0.0f);
+                float s = is_v ? beta[j] : beta[j] * exp(gamma[j]);
+                et[x] = v * s;
+            }
+            simdgroup_float8x8 b = is_v
+                ? frag_load(vp + ulong(bj * 8) * p.mixed_stride + col, p.mixed_stride, len - bj * 8, cols, rc)
+                : frag_load(kp + ulong(bj * 8) * p.mixed_stride + col, p.mixed_stride, len - bj * 8, 8, rc,
+                            k_scale[bj * 8 + rc.x]);
+            simdgroup_multiply_accumulate(acc, t, b, acc);
+        }
+        thread auto &e = acc.thread_elements();
+        uint i = bi * 8 + rc.x;
+        if (i < len) {
+            device float *dst = sc + ulong(i) * srow + (is_v ? l.u : 0) + col;
+            for (uint x = 0; x < 2; ++x) {
+                if (rc.y + x < cols) {
+                    dst[rc.y + x] = e[x];
+                }
+            }
+        }
+    }
+    for (uint t = tid; t < len; t += threads) {
+        sc[ulong(t) * srow + l.gamma] = gamma[t];
+    }
+}
+
+// Stage `C` rows of KT columns at `src` (row stride `stride`, 4-byte aligned) into
+// `tile`, each row scaled by `scale[r]` (zero at or past the chunk's length). Transposed
+// staging writes column c of the rows as tile row c (stride C + 4).
+template <uint C, uint KT, bool TRANSPOSE>
+static inline void stage_rows(
+    threadgroup float *tile, device const float *src, ulong stride, uint len,
+    threadgroup const float *scale, uint tid, uint threads) {
+    constexpr uint LT = KT + 4;
+    constexpr uint LC = C + 4;
+    constexpr uint Q = KT / 4;
+    for (uint e = tid; e < C * Q; e += threads) {
+        uint r = TRANSPOSE ? e % C : e / Q;
+        uint c = 4 * (TRANSPOSE ? e / C : e % Q);
+        float4 v = 0.0f;
+        if (r < len) {
+            v = float4(*(device const packed_float4 *)(src + ulong(r) * stride + c)) * scale[r];
+        }
+        if (TRANSPOSE) {
+            tile[c * LC + r] = v.x;
+            tile[(c + 1) * LC + r] = v.y;
+            tile[(c + 2) * LC + r] = v.z;
+            tile[(c + 3) * LC + r] = v.w;
+        } else {
+            *(threadgroup float4 *)(tile + r * LT + c) = v;
+        }
+    }
+}
+
+// One threadgroup per (sequence, value head, sgs x 8 value columns); simdgroup g owns
+// 8 value columns, with the state's DK x 8 slice in DK / 8 matrix registers. Per chunk
+// the threadgroup stages P, then W, e^γ Q and (e^{γ_L-γ} K)ᵀ (q and k normalised by
+// their `prep` scales) in KT-column tiles that
+// every simdgroup multiplies with its own slice; nothing a product waits on is read from
+// device memory element by element. The state is loaded from the committed slot and
+// stored once, rounded like the token scan's final state.
+template <uint C, uint DK, typename T>
+kernel void delta_chunk_scan(
+    device const float *prep [[buffer(0)]],
+    device const float *scratch [[buffer(1)]],
+    device T *pool [[buffer(2)]],
+    device float *out [[buffer(3)]],
+    constant ScanParams &p [[buffer(4)]],
+    device const RecurrentSpan *spans [[buffer(5)]],
+    device const uint *slots [[buffer(6)]],
+    device const uint *order [[buffer(7)]],
+    device const float *mixed [[buffer(8)]],
+    uint tg [[threadgroup_position_in_grid]],
+    uint tid [[thread_index_in_threadgroup]],
+    uint threads [[threads_per_threadgroup]],
+    uint sg [[simdgroup_index_in_threadgroup]],
+    uint lane [[thread_index_in_simdgroup]],
+    uint sgs [[simdgroups_per_threadgroup]]) {
+    constexpr uint KB = DK / 8;
+    constexpr uint B = C / 8;
+    constexpr uint KT = DK < 2048 / C ? DK : 2048 / C;
+    constexpr uint LT = KT + 4;
+    constexpr uint LC = C + 4;
+    constexpr uint TILES = DK / KT;
+    constexpr uint TB = KT / 8;
+    constexpr uint TILE = C * LT > KT * LC ? C * LT : KT * LC;
+    threadgroup float tile[TILE];
+    threadgroup float pt[C * LC];
+    // Per-row staging scales: 1 for W, e^γ times the q scale, e^{γ_L-γ} times the k scale.
+    threadgroup float ones[C];
+    threadgroup float q_factor[C];
+    threadgroup float k_factor[C];
+    uint dv = p.value_dim;
+    uint blocks = (dv + 7) / 8;
+    uint groups = (blocks + sgs - 1) / sgs;
+    uint per_sequence = p.heads * groups;
+    uint index = tg / per_sequence;
+    if (index >= p.sequences) {
+        return;
+    }
+    RecurrentSpan s = spans[order[index]];
+    uint h = (tg % per_sequence) / groups;
+    uint block = (tg % groups) * sgs + sg;
+    // Simdgroups past the last block stage tiles but load and store nothing.
+    uint c0 = min(block, blocks - 1) * 8;
+    uint cols = block < blocks ? min(8u, dv - c0) : 0;
+    uint kh = h / p.groups;
+    uint key_heads = p.heads / p.groups;
+    ChunkLayout l = chunk_layout(C, p);
+    ulong srow = ulong(p.heads) * l.stride;
+    ushort2 rc = fragment_coord(ushort(lane));
+    ulong state_size = ulong(p.heads) * DK * dv;
+    ulong head_state = ulong(h) * DK * dv + c0;
+
+    simdgroup_float8x8 st[KB];
+    device const T *state_in = pool + ulong(s.read) * state_size + head_state;
+    #pragma clang loop unroll(full)
+    for (uint d = 0; d < KB; ++d) {
+        thread auto &e = st[d].thread_elements();
+        device const T *at = state_in + ulong(d * 8 + rc.x) * dv + rc.y;
+        e[0] = rc.y < cols ? float(at[0]) : 0.0f;
+        e[1] = rc.y + 1 < cols ? float(at[1]) : 0.0f;
+    }
+    for (uint t0 = 0; t0 < s.tokens; t0 += C) {
+        uint len = min(C, s.tokens - t0);
+        uint row0 = s.row + t0;
+        device const float *sc = scratch + (ulong(row0) * p.heads + h) * l.stride;
+        device const float *qp = mixed + ulong(row0) * p.mixed_stride + kh * DK;
+        device const float *kp = qp + p.key_width;
+        // U loads are issued first; W S hides their latency.
+        simdgroup_float8x8 vn[B];
+        #pragma clang loop unroll(full)
+        for (uint bi = 0; bi < B; ++bi) {
+            uint rows = bi * 8 < len ? len - bi * 8 : 0;
+            vn[bi] = frag_load(sc + ulong(bi * 8) * srow + l.u + c0, srow, rows, cols, rc);
+        }
+        float last = sc[ulong(len - 1) * srow + l.gamma];
+        for (uint t = tid; t < C; t += threads) {
+            bool valid = t < len;
+            float g = valid ? sc[ulong(t) * srow + l.gamma] : 0.0f;
+            device const float *pr = prep + ulong(row0 + (valid ? t : 0)) * p.prep_stride;
+            ones[t] = 1.0f;
+            q_factor[t] = valid ? exp(g) * pr[kh] : 0.0f;
+            k_factor[t] = valid ? exp(last - g) * pr[key_heads + kh] : 0.0f;
+        }
+        // P's lower blocks; the upper ones are never written by the prepare kernel.
+        for (uint e = tid; e < C * C; e += threads) {
+            uint i = e / C, j = e % C;
+            pt[i * LC + j] = i < len && j / 8 <= i / 8 ? sc[ulong(i) * srow + l.p + j] : 0.0f;
+        }
+        threadgroup_barrier(mem_flags::mem_threadgroup);
+
+        // V' = U - W S
+        simdgroup_float8x8 ws[B];
+        #pragma clang loop unroll(full)
+        for (uint bi = 0; bi < B; ++bi) {
+            ws[bi] = simdgroup_float8x8(0.0f);
+        }
+        #pragma clang loop unroll(full)
+        for (uint kt = 0; kt < TILES; ++kt) {
+            stage_rows<C, KT, false>(tile, sc + kt * KT, srow, len, ones, tid, threads);
+            threadgroup_barrier(mem_flags::mem_threadgroup);
+            #pragma clang loop unroll(full)
+            for (uint bi = 0; bi < B; ++bi) {
+                if (bi * 8 < len) {
+                    #pragma clang loop unroll(full)
+                    for (uint d = 0; d < TB; ++d) {
+                        simdgroup_float8x8 a;
+                        simdgroup_load(a, tile + bi * 8 * LT + d * 8, LT);
+                        simdgroup_multiply_accumulate(ws[bi], a, st[kt * TB + d], ws[bi]);
+                    }
+                }
+            }
+            threadgroup_barrier(mem_flags::mem_threadgroup);
+        }
+        #pragma clang loop unroll(full)
+        for (uint bi = 0; bi < B; ++bi) {
+            thread auto &e = vn[bi].thread_elements();
+            thread auto &f = ws[bi].thread_elements();
+            e[0] -= f[0];
+            e[1] -= f[1];
+        }
+
+        // O = (e^γ Q) S + P V'
+        simdgroup_float8x8 o[B];
+        #pragma clang loop unroll(full)
+        for (uint bi = 0; bi < B; ++bi) {
+            o[bi] = simdgroup_float8x8(0.0f);
+            #pragma clang loop unroll(full)
+            for (uint bj = 0; bj <= bi; ++bj) {
+                simdgroup_float8x8 a;
+                simdgroup_load(a, pt + bi * 8 * LC + bj * 8, LC);
+                simdgroup_multiply_accumulate(o[bi], a, vn[bj], o[bi]);
+            }
+        }
+        #pragma clang loop unroll(full)
+        for (uint kt = 0; kt < TILES; ++kt) {
+            stage_rows<C, KT, false>(tile, qp + kt * KT, p.mixed_stride, len, q_factor, tid, threads);
+            threadgroup_barrier(mem_flags::mem_threadgroup);
+            #pragma clang loop unroll(full)
+            for (uint bi = 0; bi < B; ++bi) {
+                if (bi * 8 < len) {
+                    #pragma clang loop unroll(full)
+                    for (uint d = 0; d < TB; ++d) {
+                        simdgroup_float8x8 a;
+                        simdgroup_load(a, tile + bi * 8 * LT + d * 8, LT);
+                        simdgroup_multiply_accumulate(o[bi], a, st[kt * TB + d], o[bi]);
+                    }
+                }
+            }
+            threadgroup_barrier(mem_flags::mem_threadgroup);
+        }
+        #pragma clang loop unroll(full)
+        for (uint bi = 0; bi < B; ++bi) {
+            thread auto &e = o[bi].thread_elements();
+            uint i = bi * 8 + rc.x;
+            if (i < len) {
+                device float *dst = out + (ulong(row0 + i) * p.heads + h) * dv + c0;
+                if (rc.y < cols) {
+                    dst[rc.y] = e[0];
+                }
+                if (rc.y + 1 < cols) {
+                    dst[rc.y + 1] = e[1];
+                }
+            }
+        }
+
+        // S' = e^{γ_L} S + (e^{γ_L-γ} K)ᵀ V'
+        float decay = exp(last);
+        #pragma clang loop unroll(full)
+        for (uint d = 0; d < KB; ++d) {
+            thread auto &e = st[d].thread_elements();
+            e[0] *= decay;
+            e[1] *= decay;
+        }
+        #pragma clang loop unroll(full)
+        for (uint kt = 0; kt < TILES; ++kt) {
+            stage_rows<C, KT, true>(tile, kp + kt * KT, p.mixed_stride, len, k_factor, tid, threads);
+            threadgroup_barrier(mem_flags::mem_threadgroup);
+            #pragma clang loop unroll(full)
+            for (uint d = 0; d < TB; ++d) {
+                #pragma clang loop unroll(full)
+                for (uint bj = 0; bj < B; ++bj) {
+                    if (bj * 8 < len) {
+                        simdgroup_float8x8 a;
+                        simdgroup_load(a, tile + d * 8 * LC + bj * 8, LC);
+                        simdgroup_multiply_accumulate(st[kt * TB + d], a, vn[bj], st[kt * TB + d]);
+                    }
+                }
+            }
+            threadgroup_barrier(mem_flags::mem_threadgroup);
+        }
+    }
+    device T *final_state = pool + ulong(slots[s.writes]) * state_size + head_state;
+    uint position = s.position + s.tokens - 1;
+    #pragma clang loop unroll(full)
+    for (uint d = 0; d < KB; ++d) {
+        thread auto &e = st[d].thread_elements();
+        ulong at = ulong(d * 8 + rc.x) * dv + rc.y;
+        uint element = uint(head_state + at);
+        if (rc.y < cols) {
+            final_state[at] = store_state<T>(e[0], position, element);
+        }
+        if (rc.y + 1 < cols) {
+            final_state[at + 1] = store_state<T>(e[1], position, element + 1);
+        }
+    }
+}
+
+#define CHUNK_PREPARE(C) \
+    template [[host_name("delta_chunk_prepare_c" #C)]] kernel void delta_chunk_prepare<C>( \
+        device const float *, device const float *, device const float *, device const float *, \
+        device const float *, device float *, constant ScanParams &, device const uint2 *, \
+        uint, uint, uint, uint, uint, uint);
+CHUNK_PREPARE(32)
+CHUNK_PREPARE(64)
+
+#define CHUNK_SCAN(C, DK, T, NAME) \
+    template [[host_name("delta_chunk_scan_c" #C "_d" #DK "_" #NAME)]] kernel void delta_chunk_scan<C, DK, T>( \
+        device const float *, device const float *, device T *, device float *, \
+        constant ScanParams &, device const RecurrentSpan *, device const uint *, \
+        device const uint *, device const float *, uint, uint, uint, uint, uint, uint);
+#define CHUNK_SCANS(C, T, NAME) CHUNK_SCAN(C, 64, T, NAME) CHUNK_SCAN(C, 128, T, NAME) CHUNK_SCAN(C, 256, T, NAME)
+CHUNK_SCANS(32, float, f32)
+CHUNK_SCANS(32, half, f16)
+CHUNK_SCANS(32, bfloat, bf16)
+CHUNK_SCANS(64, float, f32)
