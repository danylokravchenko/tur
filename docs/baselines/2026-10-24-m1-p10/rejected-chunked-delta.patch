+#[test]
+fn test_chunked_delta_prefill_matches_recurrence_across_chunk_boundaries() -> Result<()> {
+    let (device, kernels, _gpu) = setup()?;
+    assert!(
+        kernels
+            .clone()
+            .with_tuning(Tuning {
+                delta_chunk: 128,
+                ..kernels.tuning()
+            })
+            .is_err()
+    );
+    for chunk in [32usize, 64] {
+        let kernels = kernels.clone().with_tuning(Tuning {
+            delta_chunk: chunk,
+            delta_chunk_tokens: 2,
+            ..kernels.tuning()
+        })?;
+        // Grouped heads with partial value blocks, one key head shared by three value
+        // heads at the model's head size, and the widest key dim.
+        for (key_heads, value_heads, dk, dv) in [(2, 4, 64, 22), (1, 3, 128, 128), (1, 1, 256, 16)]
+        {
+            let case = scan_case(key_heads, value_heads, dk, dv);
+            // Partial, exact and spilling chunks, a long prefill, a decode and a
+            // speculative window in one pass; two prefills fork from committed slot 0.
+            let ragged: Vec<(usize, u32, Vec<u32>)> = vec![
+                (2, 0, vec![1]),
+                (chunk - 1, 0, vec![2]),
+                (chunk, 3, vec![4]),
+                (chunk + 1, 5, vec![6]),
+                (2 * chunk + 5, 7, vec![8]),
+                (600, 9, vec![10]),
+                (1, 11, vec![12]),
+                (4, 13, vec![14, 15, 16, 17]),
+            ];
+            let rows: usize = ragged.iter().map(|(tokens, _, _)| tokens).sum();
+            let mut inputs = ScanInputs::new(&case, rows, 30 + dk as u64);
+            // Near-total forgetting in the third sequence, near-perfect memory in the fifth.
+            let starts: Vec<usize> = ragged
+                .iter()
+                .scan(0, |row, (tokens, _, _)| {
+                    let start = *row;
+                    *row += tokens;
+                    Some(start)
+                })
+                .collect();
+            inputs.set_decay_gate(&case, starts[2]..starts[2] + chunk, 40.0);
+            inputs.set_decay_gate(&case, starts[4]..starts[4] + 2 * chunk + 5, -40.0);
+            for dtype in [DType::F32, DType::F16, DType::BF16] {
+                let (pool, _) = committed_pool(&device, 18, &[value_heads, dk, dv], &ragged, 0.1)?;
+                let pool = pool.to_dtype(dtype)?;
+                let widen = |slot: usize| -> Result<Vec<f32>> {
+                    read(&pool.get(slot)?.to_dtype(DType::F32)?)
+                };
+                let initial: Vec<Vec<f32>> = (0..18).map(widen).collect::<Result<_>>()?;
+                let addressing = kernels.recurrent_spans(&spans(&ragged))?;
+                assert_eq!(addressing.chunked(), 6);
+                let out = inputs.run(&kernels, &device, &case, &addressing, &pool)?;
+                for ((tokens, slot, writes), start) in ragged.iter().zip(&starts) {
+                    let (expected_out, expected_states) = scan_reference(
+                        &case,
+                        &inputs.mixed,
+                        &inputs.proj,
+                        *start..start + tokens,
+                        &inputs.dt_bias,
+                        &inputs.neg_a,
+                        &initial[*slot as usize],
+                    );
