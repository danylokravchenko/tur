+/// Several prompts prefilled in one pass: the token scan against each chunk length.
+fn delta_batched_prefill_cases(
+    device: &Device,
+    scan_only: &Kernels,
+    chunked: &[(usize, Kernels)],
+    label: &str,
+    shape: DeltaShape,
+) -> Result<Vec<Value>> {
+    let mut cases = Vec::new();
+    let heads = shape.value_heads;
+    for (sequences, tokens) in [(4usize, 128usize), (8, 256), (16, 128)] {
+        let rows = sequences * tokens;
+        let mixed = random(device, &[rows, shape.channels()], 7, 1.0)?;
+        let proj = random(device, &[rows, 2 * heads], 8, 1.0)?;
+        let dt_bias = random(device, &[heads], 11, 1.0)?;
+        let neg_a = (random(device, &[heads], 12, 1.0)?.abs()? * -1.0)?;
+        let state = random(device, &[2 * sequences, heads, 128, 128], 13, 0.1)?;
+        let writes: Vec<[u32; 1]> = (0..sequences)
+            .map(|i| [u32::try_from(sequences + i).unwrap_or(0)])
+            .collect();
+        let spans: Vec<RecurrentSpan<'_>> = writes
+            .iter()
+            .enumerate()
+            .map(|(i, write)| RecurrentSpan {
+                tokens,
+                position: 0,
+                read: u32::try_from(i).unwrap_or(0),
+                writes: write,
+            })
+            .collect();
+        let ragged = scan_only.recurrent_spans(&spans)?;
+        let scan = time(device, || {
+            scan_only.delta_scan(&mixed, &proj, &ragged, &shape, &dt_bias, &neg_a, &state)
+        })?;
+        let mut chunks = Vec::new();
+        for (chunk, tuned) in chunked {
+            let ragged = tuned.recurrent_spans(&spans)?;
+            let timing = time(device, || {
+                tuned.delta_scan(&mixed, &proj, &ragged, &shape, &dt_bias, &neg_a, &state)
+            })?;
+            chunks.push(json!({
+                "chunk": chunk, "scan": timing, "speedup": speedup(&timing, &scan),
+            }));
+        }
+        cases.push(json!({
+            "operation": "delta_net_batched_prefill", "shape": label,
+            "sequences": sequences, "tokens": tokens, "scan": scan, "chunked": chunks,
+        }));
+    }
+    Ok(cases)
+}
