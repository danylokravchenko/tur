+/// Inputs of one recurrent test pass.
+struct ScanInputs {
+    mixed: Vec<f32>,
+    proj: Vec<f32>,
+    dt_bias: Vec<f32>,
+    neg_a: Vec<f32>,
+}
+
+impl ScanInputs {
+    fn new(case: &ScanCase, rows: usize, seed: u64) -> Self {
+        let heads = case.shape.value_heads;
+        Self {
+            mixed: values(rows * case.mixed_cols, seed, 1.0),
+            proj: values(rows * case.proj_cols, seed + 1, 3.0),
+            dt_bias: values(heads, seed + 2, 1.0),
+            neg_a: values(heads, seed + 3, 1.0)
+                .iter()
+                .map(|v| -v.abs() - 0.1)
+                .collect(),
+        }
+    }
+
+    /// Set the decay gate of every head on `rows`: large values forget the state almost
+    /// completely each token, very negative ones keep it almost unchanged.
+    fn set_decay_gate(&mut self, case: &ScanCase, rows: std::ops::Range<usize>, gate: f32) {
+        for row in rows {
+            for h in 0..case.shape.value_heads {
+                self.proj[row * case.proj_cols + case.shape.a_col + h] = gate;
+            }
+        }
+    }
+
+    fn run(
+        &self,
+        kernels: &Kernels,
+        device: &Device,
+        case: &ScanCase,
+        spans: &tur_metal::kernels::RecurrentSpans,
+        pool: &Tensor,
+    ) -> Result<Tensor> {
+        let rows = spans.tokens();
+        let heads = case.shape.value_heads;
+        kernels.delta_scan(
+            &upload(device, &self.mixed, &[rows, case.mixed_cols])?,
+            &upload(device, &self.proj, &[rows, case.proj_cols])?,
+            spans,
+            &case.shape,
+            &upload(device, &self.dt_bias, &[heads])?,
+            &upload(device, &self.neg_a, &[heads])?,
+            pool,
+        )
+    }
+}
+
+fn scan_case(key_heads: usize, value_heads: usize, key_dim: usize, value_dim: usize) -> ScanCase {
+    let shape = DeltaShape {
+        key_heads,
+        value_heads,
+        key_dim,
+        value_dim,
+        b_col: 1,
+        a_col: 1 + value_heads,
+    };
+    ScanCase {
+        shape,
+        mixed_cols: shape.channels() + 5,
+        proj_cols: 2 * value_heads + 3,
+    }
+}
+
+fn stored_tolerance(dtype: DType) -> f64 {
+    match dtype {
+        DType::F32 => 1e-5,
+        DType::F16 => 1e-3,
+        _ => 8e-3,
+    }
+}
