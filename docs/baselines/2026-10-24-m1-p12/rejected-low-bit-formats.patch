+#![forbid(unsafe_code)]
+//! Host reference of the 4- to 6-bit K/V codecs: symmetric and asymmetric groupwise codes
+//! and the `TurboQuant` rotations, codebooks and QJL residual signs. The kernels apply the same
+//! arithmetic in the same order, so their codes match these except where float division
+//! rounding moves a value across a decision boundary.
+//!
+//! Rotated codecs store `y = H·D·x / √d`, with `H` the Sylvester Hadamard matrix and `D`
+//! a diagonal of pseudo-random signs fixed by [`ROTATION_SEED`]. The QJL projection is
+//! `S = H·D₂` (rows of norm `√d`, like an i.i.d. Gaussian sketch) with signs from
+//! [`QJL_SEED`]. Both seeds are part of [`tur_core::execution::KV_LAYOUT_VERSION`].
+
+use candle_core::{DType, Device, Tensor};
+use tur_core::{
+    Result,
+    execution::{KvCodec, invalid},
+};
+
+/// Seed of the rotation signs `D`.
+pub const ROTATION_SEED: u32 = 0x5EED_0001;
+/// Seed of the QJL projection signs `D₂`.
+pub const QJL_SEED: u32 = 0x5EED_0002;
+
+/// Lloyd–Max reconstruction levels of a unit Gaussian at 16 levels (Max, 1960).
+pub const LLOYD_MAX_16: [f32; 16] = [
+    -2.732_589_6,
+    -2.069_017_2,
+    -1.618_046_4,
+    -1.256_231_2,
