+mod tests {
+    use super::*;
+
+    fn rows(n: usize, dim: usize, seed: u32) -> Vec<f32> {
+        (0..n * dim)
+            .map(|i| {
+                let u = hash(seed.wrapping_mul(0x9e37_79b9) ^ i as u32) as f32 / u32::MAX as f32;
+                // A few large outlier channels, as real keys have.
+                let outlier = if i % dim == 3 { 12.0 } else { 1.0 };
+                u.mul_add(2.0, -1.0) * outlier
+            })
+            .collect()
+    }
+
+    fn mse(a: &[f32], b: &[f32]) -> f32 {
+        a.iter().zip(b).map(|(x, y)| (x - y).powi(2)).sum::<f32>() / a.len() as f32
+    }
+
+    #[test]
+    fn test_rotation_is_orthonormal_and_inverts() {
+        for dim in [64usize, 128, 256] {
+            let x = rows(1, dim, 1);
+            let mut y = x.clone();
+            rotate(&mut y);
+            let norm = |v: &[f32]| v.iter().map(|a| a * a).sum::<f32>().sqrt();
+            assert!((norm(&x) - norm(&y)).abs() < 1e-4 * norm(&x));
+            unrotate(&mut y);
+            assert!(mse(&x, &y) < 1e-12);
