+/// Positive half of the 64-level Lloyd–Max codebook of a unit Gaussian.
+const LLOYD_MAX_64_HALF: [f32; 32] = [
+    0.033_409_5,
+    0.100_278_3,
+    0.167_296_9,
+    0.234_567,
+    0.302_192_8,
+    0.370_282_6,
