new file mode 100644
index 0000000..634450e
--- /dev/null
+++ b/crates/tur-engine/examples/kv_stats.rs
@@ -0,0 +1,219 @@
+#![allow(clippy::print_stdout, reason = "diagnostic tool prints a JSON report")]
+#![forbid(unsafe_code)]
+//! K/V statistics on a real checkpoint: runs held-out text through the model with F32 K/V,
+//! reads every attention layer's keys and values back, and reports per K/V head the static
+//! per-channel share of the energy, peak-to-RMS ratios, the largest channel offsets, and the
+//! relative squared error of each 4-bit codec on raw and channel-centered rows.
+//!
+//! `TUR_QWEN35_0_8B=<snapshot> TUR_EVAL_TEXT=<file> cargo run --release --offline -p tur-engine
+//! --example kv_stats > stats.json`; `TUR_EVAL_TOKENS` (default 4096) bounds the context.
+
+use candle_core::{DType, Device, Tensor};
+use serde_json::{Value, json};
+use std::{path::PathBuf, sync::Arc};
+use tur_core::{
+    Result, TurError,
+    execution::{KvCodec, KvFormat, KvLayout, invalid},
+};
+use tur_engine::hybrid::{
+    Boundaries, HybridModel, ModelState, PackedForward, PoolConfig, SequenceForward, StatePool,
+};
+use tur_metal::{
+    pool::{dequantize, quantize},
+    state::LayerSnapshot,
+};
+use tur_models::models::qwen3_5::{Execution, LoadOptions, Qwen35, WeightFormat};
+
+const CODECS: [KvCodec; 5] = [
+    KvCodec::Q8 { group: 32 },
+    KvCodec::Q4 { group: 32 },
+    KvCodec::Q4A { group: 32 },
+    KvCodec::Tq4,
+    KvCodec::Tq3Qjl,
+];
+
+/// Relative squared error of `codec` on `[n, dim]` rows.
+fn codec_error(codec: KvCodec, rows: &[f32], dim: usize) -> Result<f64> {
+    let n = rows.len() / dim;
+    let x = Tensor::from_slice(rows, (n, 1, dim), &Device::Cpu)?;
+    let (data, scales) = quantize(codec, &x)?;
+    let y = dequantize(codec, &data, scales.as_ref())?
+        .flatten_all()?
+        .to_vec1::<f32>()?;
+    let (mut error, mut power) = (0f64, 0f64);
+    for (a, b) in rows.iter().zip(&y) {
+        error += f64::from(a - b).powi(2);
+        power += f64::from(*a).powi(2);
+    }
+    Ok(error / power.max(f64::MIN_POSITIVE))
+}
+
+/// Statistics of one head's `[n, dim]` rows; `rotary` leading dimensions are rotated.
+fn head_stats(rows: &[f32], dim: usize, rotary: usize) -> Result<Value> {
+    let n = rows.len() / dim;
+    let mut mean = vec![0f64; dim];
+    let mut square = vec![0f64; dim];
+    for row in rows.chunks(dim) {
+        for (c, v) in row.iter().enumerate() {
+            mean[c] += f64::from(*v);
+            square[c] += f64::from(*v).powi(2);
+        }
+    }
+    for (m, s) in mean.iter_mut().zip(&mut square) {
+        *m /= n as f64;
+        *s /= n as f64;
+    }
+    let share = |range: std::ops::Range<usize>| {
+        let static_energy: f64 = range.clone().map(|c| mean[c].powi(2)).sum();
+        let total: f64 = range.map(|c| square[c]).sum();
+        static_energy / total.max(f64::MIN_POSITIVE)
+    };
+    let peak = rows
+        .chunks(dim)
+        .map(|row| {
+            let rms = (row.iter().map(|v| v * v).sum::<f32>() / dim as f32).sqrt();
+            row.iter().fold(0f32, |m, v| m.max(v.abs())) / rms.max(f32::MIN_POSITIVE)
+        })
+        .sum::<f32>()
+        / n as f32;
+    let mut channels: Vec<usize> = (0..dim).collect();
+    channels.sort_by(|a, b| mean[*b].abs().total_cmp(&mean[*a].abs()));
+    let top: Vec<Value> = channels
+        .iter()
+        .take(4)
+        .map(|&c| {
+            let std = mean[c].mul_add(-mean[c], square[c]).max(0.0).sqrt();
+            json!({"channel": c, "mean": mean[c], "std": std})
+        })
+        .collect();
+    let centered: Vec<f32> = rows
+        .chunks(dim)
+        .flat_map(|row| row.iter().zip(&mean).map(|(v, m)| v - *m as f32))
+        .collect();
+    let mut errors = serde_json::Map::new();
+    for codec in CODECS {
+        let name = format!("{codec:?}").to_lowercase();
+        errors.insert(
+            name,
+            json!({
+                "raw": codec_error(codec, rows, dim)?,
+                "centered": codec_error(codec, &centered, dim)?,
+            }),
+        );
+    }
+    Ok(json!({
+        "rms": (square.iter().sum::<f64>() / dim as f64).sqrt(),
+        "static_share": share(0..dim),
+        "static_share_rotary": share(0..rotary),
+        "static_share_fixed": share(rotary..dim),
+        "peak_to_rms": peak,
+        "largest_offsets": top,
+        "relative_squared_error": errors,
+    }))
+}
+
+fn main() -> Result<()> {
+    let var = |name: &str| {
+        std::env::var_os(name)
+            .map(PathBuf::from)
+            .ok_or_else(|| TurError::Other(format!("set {name}")))
+    };
+    let dir = var("TUR_QWEN35_0_8B")?;
+    let text = std::fs::read_to_string(var("TUR_EVAL_TEXT")?)?;
+    let limit: usize = std::env::var("TUR_EVAL_TOKENS")
+        .unwrap_or_else(|_| "4096".into())
+        .parse()
+        .map_err(|_| invalid("TUR_EVAL_TOKENS"))?;
+    let tokenizer = tokenizers::Tokenizer::from_file(dir.join("tokenizer.json"))
+        .map_err(|e| TurError::Tokenizer(e.to_string()))?;
+    let mut tokens = tokenizer
+        .encode(text.as_str(), false)
+        .map_err(|e| TurError::Tokenizer(e.to_string()))?
+        .get_ids()
+        .to_vec();
+    tokens.truncate(limit);
+    let device = Device::new_metal(0)?;
+    let model = Qwen35::load(
+        &dir,
+        &LoadOptions {
+            revision: "Qwen/Qwen3.5-0.8B@2fc06364".into(),
+            weights: WeightFormat::Q8_0.into(),
+            device: device.clone(),
+            execution: Execution::Fused,
+            kv: KvLayout::new(16, KvFormat::F32),
+            recurrent: DType::F32,
+            mtp: false,
+        },
+    )?;
+    let description = model.description();
+    let pool = StatePool::new(
+        Arc::new(description.clone()),
+        &device,
+        PoolConfig {
+            pages: description.pages_for(tokens.len()) + 1,
+            recurrent_slots: 2,
+        },
+    )?;
+    let mut state = ModelState::new(&pool);
+    for chunk in tokens.chunks(256) {
+        let mut reservation = state.reserve(chunk.len(), Boundaries::Final)?;
+        reservation.prepare()?;
+        let binding = reservation.binding();
+        let start = state.position();
+        let positions: Vec<usize> = (start..start + chunk.len()).collect();
+        model.forward(&PackedForward {
+            tokens: chunk,
+            positions: &positions,
+            sequences: &[SequenceForward {
+                tokens: 0..chunk.len(),
+                state: &binding,
+                logits: &[],
+                hidden: false,
+            }],
+            pool: &pool,
+        })?;
+        state = reservation.commit(chunk.len())?;
+        drop(reservation);
+        device.synchronize()?;
+        pool.reclaim();
+    }
+    // Rotated leading dimensions per head, from the checkpoint's own configuration.
+    let config: Value = serde_json::from_str(&std::fs::read_to_string(dir.join("config.json"))?)?;
+    let text_config = &config["text_config"];
+    let rotary = (text_config["head_dim"].as_f64().unwrap_or(0.0)
+        * text_config["rope_parameters"]["partial_rotary_factor"]
+            .as_f64()
+            .unwrap_or(1.0)) as usize;
+    let mut layers = Vec::new();
+    for (index, layer) in state.read_layers()?.into_iter().enumerate() {
+        let LayerSnapshot::Attention { key, value } = layer else {
+            continue;
+        };
+        let (_, heads, dim) = key.dims3()?;
+        let mut per_head = Vec::new();
+        for h in 0..heads {
+            let rows = |t: &Tensor| -> Result<Vec<f32>> {
+                Ok(t.narrow(1, h, 1)?
+                    .to_device(&Device::Cpu)?
+                    .flatten_all()?
+                    .to_vec1::<f32>()?)
+            };
+            per_head.push(json!({
+                "head": h,
+                "key": head_stats(&rows(&key)?, dim, rotary)?,
+                "value": head_stats(&rows(&value)?, dim, rotary)?,
+            }));
+        }
+        layers.push(json!({"layer": index, "heads": per_head}));
+    }
+    let report = json!({
+        "checkpoint": "Qwen/Qwen3.5-0.8B@2fc06364715b967f1860aea9cf38778875588b17",
+        "tokens": tokens.len(),
+        "rotary_dims": rotary,
+        "static_share": "sum of squared per-channel means over the mean squared value",
+        "layers": layers,
+    });
+    let output = serde_json::to_string_pretty(&report)?;
+    std::io::Write::write_all(&mut std::io::stdout(), output.as_bytes())?;
+    Ok(())
+}
