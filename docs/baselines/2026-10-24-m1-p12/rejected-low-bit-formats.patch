+    0.656_759_1,
+    0.942_340_5,
+    1.256_231_2,
+    1.618_046_4,
+    2.069_017_2,
+    2.732_589_6,
+];
+
+/// Lloyd–Max reconstruction levels of a unit Gaussian at 8 levels.
+pub const LLOYD_MAX_8: [f32; 8] = [
+    -2.151_945_7,
