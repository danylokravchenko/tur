+
+/// A symmetric codebook from its positive half, in increasing order.
+fn mirrored(half: &[f32]) -> Vec<f32> {
+    half.iter()
+        .rev()
+        .map(|v| -v)
+        .chain(half.iter().copied())
+        .collect()
+}
+
+/// The Lloyd–Max codebook of a rotated codec.
+fn codebook(codec: KvCodec) -> Vec<f32> {
+    match codec {
+        KvCodec::Tq5 => mirrored(&LLOYD_MAX_32_HALF),
+        KvCodec::Tq6 => mirrored(&LLOYD_MAX_64_HALF),
+        KvCodec::Tq3Qjl => LLOYD_MAX_8.to_vec(),
+        _ => LLOYD_MAX_16.to_vec(),
+    }
+}
+
+/// Pack `bits`-bit codes of rows of `dim`: per row, the low nibbles two per byte, then the
+/// remaining high bits `8 / (bits - 4)` per byte, lowest dimension in the lowest bits.
+fn pack(codes: &[u8], dim: usize, bits: usize) -> Vec<u8> {
+    let high = bits - 4;
+    let mut out = Vec::with_capacity(codes.len() * bits / 8);
+    for row in codes.chunks(dim) {
+        out.extend(row.chunks(2).map(|p| (p[0] & 15) | ((p[1] & 15) << 4)));
+        if let Some(per) = 8usize.checked_div(high) {
+            out.extend(row.chunks(per).map(|group| {
+                group
+                    .iter()
+                    .enumerate()
+                    .fold(0u8, |byte, (i, c)| byte | ((c >> 4) << (i * high)))
+            }));
+        }
+    }
+    out
+}
+
+/// Inverse of [`pack`].
+fn unpack(bytes: &[u8], dim: usize, bits: usize) -> Vec<u8> {
+    let high = bits - 4;
+    let mask = (1u8 << high) - 1;
+    let mut codes = Vec::with_capacity(bytes.len() * 8 / bits);
+    for row in bytes.chunks(dim * bits / 8) {
+        let (low, upper) = row.split_at(dim / 2);
+        let start = codes.len();
+        codes.extend(low.iter().flat_map(|b| [b & 15, b >> 4]));
+        if let Some(per) = 8usize.checked_div(high) {
+            for (i, code) in codes[start..].iter_mut().enumerate() {
+                *code |= ((upper[i / per] >> ((i % per) * high)) & mask) << 4;
+            }
+        }
+    }
+    codes
+}
+
+/// `lowbias32` integer hash; the kernels use the same function.
+fn hash(mut x: u32) -> u32 {
+    x ^= x >> 16;
+    x = x.wrapping_mul(0x7feb_352d);
+    x ^= x >> 15;
+    x = x.wrapping_mul(0x846c_a68b);
+    x ^ (x >> 16)
+}
+
+/// Sign `±1` of dimension `i` under `seed`.
+pub fn sign(seed: u32, i: usize) -> f32 {
+    if hash(seed ^ i as u32) & 1 == 0 {
+        1.0
+    } else {
+        -1.0
+    }
+}
+
+/// Unnormalised in-place Walsh–Hadamard transform, strides in increasing order: the
+/// kernels' butterfly order, so both round identically.
+fn hadamard(x: &mut [f32]) {
+    let n = x.len();
+    let mut stride = 1;
+    while stride < n {
+        for base in (0..n).step_by(2 * stride) {
+            for i in base..base + stride {
+                let (a, b) = (x[i], x[i + stride]);
+                x[i] = a + b;
+                x[i + stride] = a - b;
+            }
+        }
+        stride *= 2;
+    }
+}
+
+/// `H·D·x / √d`.
+pub fn rotate(x: &mut [f32]) {
+    for (i, v) in x.iter_mut().enumerate() {
+        *v *= sign(ROTATION_SEED, i);
+    }
+    hadamard(x);
+    let norm = (x.len() as f32).sqrt().recip();
+    for v in x.iter_mut() {
+        *v *= norm;
+    }
+}
+
+/// Inverse of [`rotate`]: `D·H·y / √d`.
+pub fn unrotate(y: &mut [f32]) {
+    hadamard(y);
+    let norm = (y.len() as f32).sqrt().recip();
+    for (i, v) in y.iter_mut().enumerate() {
+        *v *= norm * sign(ROTATION_SEED, i);
+    }
+}
+
+/// QJL projection `H·D₂·x` (unnormalised).
+pub fn project(x: &mut [f32]) {
+    for (i, v) in x.iter_mut().enumerate() {
+        *v *= sign(QJL_SEED, i);
+    }
+    hadamard(x);
+}
+
+/// Index of the nearest level: the number of midpoints strictly below `u`. Midpoints are
+/// `0.5 · (a + b)` in F32, exactly as the kernels compute them (`f32::midpoint` rounds
+/// once in F64 and can differ in the last bit).
+#[allow(clippy::manual_midpoint, reason = "must round like the kernels")]
+fn nearest(levels: &[f32], u: f32) -> u8 {
+    levels
+        .windows(2)
+        .filter(|w| 0.5 * (w[0] + w[1]) < u)
+        .count() as u8
+}
+
+/// Round every value to F16 and back, as the kernels store scales.
+fn round_f16(values: Vec<f32>) -> Result<Vec<f32>> {
+    let n = values.len();
+    Ok(Tensor::from_vec(values, n, &Device::Cpu)?
+        .to_dtype(DType::F16)?
+        .to_dtype(DType::F32)?
+        .to_vec1::<f32>()?)
+}
+
+/// Encode `[n, heads, dim]` rows with a 4-bit `codec`: U8 `[n, heads, dim / 2]` nibbles
+/// and F16 `[n, heads, codec.row_scales(dim)]` scales, on the input's device.
+pub fn encode(codec: KvCodec, x: &Tensor) -> Result<(Tensor, Tensor)> {
+    let (n, heads, dim) = x.dims3()?;
+    let rows = n * heads;
+    let values = x
+        .to_dtype(DType::F32)?
+        .to_device(&Device::Cpu)?
+        .flatten_all()?
+        .to_vec1::<f32>()?;
+    let per = codec.row_scales(dim);
+    let mut codes = vec![0u8; rows * dim];
+    let mut scales = vec![0f32; rows * per];
+    let divisor = |s: f32| s.max(f32::MIN_POSITIVE);
+    match codec {
+        KvCodec::Q4 { group } | KvCodec::Q6 { group } => {
+            let limit = if codec.bits() == 4 { 7.0f32 } else { 31.0 };
+            let raw = values
+                .chunks(group)
+                .map(|g| g.iter().fold(0f32, |m, v| m.max(v.abs())) * (1.0 / limit))
+                .collect();
+            scales = round_f16(raw)?;
+            for (i, v) in values.iter().enumerate() {
+                let q = (v / divisor(scales[i / group]))
+                    .round()
+                    .clamp(-limit, limit);
+                codes[i] = (q as i32 + limit as i32 + 1) as u8;
+            }
+        }
+        KvCodec::Q4A { group } => {
+            let mins = round_f16(
+                values
+                    .chunks(group)
+                    .map(|g| g.iter().fold(f32::INFINITY, |m, v| m.min(*v)))
+                    .collect(),
+            )?;
+            let raw = values
+                .chunks(group)
+                .zip(&mins)
+                .map(|(g, min)| (g.iter().fold(f32::NEG_INFINITY, |m, v| m.max(*v)) - min) / 15.0)
+                .collect();
+            let steps = round_f16(raw)?;
+            for (i, v) in values.iter().enumerate() {
+                let g = i / group;
+                codes[i] = ((v - mins[g]) / divisor(steps[g])).round().clamp(0.0, 15.0) as u8;
+            }
+            for (g, (step, min)) in steps.iter().zip(&mins).enumerate() {
+                scales[2 * g] = *step;
+                scales[2 * g + 1] = *min;
+            }
+        }
+        KvCodec::Tq4 | KvCodec::Tq5 | KvCodec::Tq6 | KvCodec::Tq3Qjl => {
+            let mut rotated = values;
+            let root = (dim as f32).sqrt().recip();
+            let raw = rotated
+                .chunks_mut(dim)
+                .map(|row| {
+                    rotate(row);
+                    row.iter().map(|v| v * v).sum::<f32>().sqrt() * root
+                })
+                .collect();
+            let row_scales = round_f16(raw)?;
+            if codec == KvCodec::Tq3Qjl {
+                let mut residual_scales = Vec::with_capacity(rows);
+                let qjl = (std::f32::consts::FRAC_PI_2).sqrt() / dim as f32;
+                for (r, row) in rotated.chunks(dim).enumerate() {
+                    let s = row_scales[r];
+                    let mut residual: Vec<f32> = row
+                        .iter()
+                        .enumerate()
+                        .map(|(i, v)| {
+                            let c = nearest(&LLOYD_MAX_8, v / divisor(s));
+                            codes[r * dim + i] = c;
+                            v / divisor(s) - LLOYD_MAX_8[c as usize]
+                        })
+                        .collect();
+                    let norm = residual.iter().map(|e| e * e).sum::<f32>().sqrt();
+                    residual_scales.push(s * qjl * norm);
+                    project(&mut residual);
+                    for (i, z) in residual.iter().enumerate() {
+                        if *z < 0.0 {
+                            codes[r * dim + i] |= 8;
+                        }
+                    }
+                }
+                let residual_scales = round_f16(residual_scales)?;
+                for r in 0..rows {
+                    scales[2 * r] = row_scales[r];
+                    scales[2 * r + 1] = residual_scales[r];
+                }
+            } else {
+                let levels = codebook(codec);
+                for (i, v) in rotated.iter().enumerate() {
+                    codes[i] = nearest(&levels, v / divisor(row_scales[i / dim]));
+                }
+                scales = row_scales;
+            }
+        }
+        _ => return Err(invalid(format!("{codec:?} is not a packed codec"))),
+    }
+    let packed = pack(&codes, dim, codec.bits());
+    let device = x.device();
+    Ok((
+        Tensor::from_vec(packed, (n, heads, codec.row_elements(dim)), &Device::Cpu)?
+            .to_device(device)?,
+        Tensor::from_vec(scales, (n, heads, per), &Device::Cpu)?
+            .to_dtype(DType::F16)?
+            .to_device(device)?,
+    ))
+}
+
+/// Inverse of [`encode`]: F32 `[n, heads, dim]` in the original basis. Rotated keys of
+/// [`KvCodec::Tq3Qjl`] decode to the QJL inner-product estimator
+/// `s·c + r·Sᵀρ` rotated back, so `q · k̂` equals the kernels' two-term score.
+pub fn decode(codec: KvCodec, data: &Tensor, scales: &Tensor) -> Result<Tensor> {
+    let (n, heads, bytes) = data.dims3()?;
+    let dim = bytes * 8 / codec.bits();
+    let per = codec.row_scales(dim);
+    if scales.dims() != [n, heads, per] {
+        return Err(invalid("K/V scales do not match the codec"));
+    }
+    let bytes = data
+        .to_device(&Device::Cpu)?
+        .flatten_all()?
+        .to_vec1::<u8>()?;
+    let scales = scales
+        .to_dtype(DType::F32)?
+        .to_device(&Device::Cpu)?
+        .flatten_all()?
+        .to_vec1::<f32>()?;
+    let codes = unpack(&bytes, dim, codec.bits());
+    let mut out = vec![0f32; codes.len()];
+    match codec {
+        KvCodec::Q4 { group } | KvCodec::Q6 { group } => {
+            let zero = if codec.bits() == 4 { 8.0 } else { 32.0 };
+            for (i, c) in codes.iter().enumerate() {
+                out[i] = scales[i / group] * (f32::from(*c) - zero);
+            }
+        }
+        KvCodec::Q4A { group } => {
+            for (i, c) in codes.iter().enumerate() {
+                let g = i / group;
+                out[i] = scales[2 * g].mul_add(f32::from(*c), scales[2 * g + 1]);
+            }
+        }
+        KvCodec::Tq4 | KvCodec::Tq5 | KvCodec::Tq6 => {
+            let levels = codebook(codec);
+            for (r, row) in out.chunks_mut(dim).enumerate() {
+                for (i, v) in row.iter_mut().enumerate() {
+                    *v = scales[r] * levels[codes[r * dim + i] as usize];
+                }
+                unrotate(row);
+            }
+        }
+        KvCodec::Tq3Qjl => {
+            for (r, row) in out.chunks_mut(dim).enumerate() {
+                let (s, residual) = (scales[2 * r], scales[2 * r + 1]);
+                // Sᵀρ = D₂·H·ρ.
+                let mut signs: Vec<f32> = codes[r * dim..(r + 1) * dim]
+                    .iter()
+                    .map(|c| if c & 8 == 0 { 1.0 } else { -1.0 })
+                    .collect();
+                hadamard(&mut signs);
+                for (i, v) in row.iter_mut().enumerate() {
+                    let c = codes[r * dim + i] & 7;
+                    *v = (residual * sign(QJL_SEED, i))
+                        .mul_add(signs[i], s * LLOYD_MAX_8[c as usize]);
+                }
+                unrotate(row);
+            }
+        }
+        _ => return Err(invalid(format!("{codec:?} is not a packed codec"))),
+    }
+    Ok(Tensor::from_vec(out, (n, heads, dim), &Device::Cpu)?.to_device(data.device())?)
+}
