{
  "architectures": [
    "GptOssForCausalLM"
  ],
  "model_type": "gpt_oss",
  "attention_bias": true,
  "attention_dropout": 0.0,
  "eos_token_id": 1,
  "pad_token_id": 0,
  "experts_per_token": 2,
  "head_dim": 64,
  "hidden_act": "silu",
  "hidden_size": 64,
  "intermediate_size": 64,
  "layer_types": [
    "sliding_attention",
    "full_attention",
    "sliding_attention",
    "full_attention"
  ],
  "max_position_embeddings": 2048,
  "num_attention_heads": 4,
  "num_experts_per_tok": 2,
  "num_hidden_layers": 4,
  "num_key_value_heads": 2,
  "num_local_experts": 4,
  "output_router_logits": false,
  "rms_norm_eps": 1e-05,
  "router_aux_loss_coef": 0.9,
  "sliding_window": 4,
  "swiglu_limit": 7.0,
  "tie_word_embeddings": false,
  "use_cache": true,
  "vocab_size": 96,
  "rope_theta": 150000,
  "quantization_config": {
    "quant_method": "mxfp4",
    "modules_to_not_convert": []
  },
  "rope_scaling": {
    "beta_fast": 32.0,
    "beta_slow": 1.0,
    "factor": 32.0,
    "original_max_position_embeddings": 64,
    "rope_type": "yarn",
    "truncate": false
  }
}
